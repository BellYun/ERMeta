# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# BSER Open API
BSER_API_KEY=your-bser-api-key
BSER_API_RATE_LIMIT_RPS=4
BSER_API_RATE_LIMIT_BURST=4
BSER_API_RATE_LIMIT_QUEUE_MAX=50

# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGINS=https://erwagg.com,https://www.erwagg.com,http://localhost:3000,http://localhost:3001
ENABLE_COLLECTOR=false
MULTI_SEARCH_SEASON_ID=39
MULTI_SEARCH_MATCHING_MODE=3

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Feedback
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxx/exec
